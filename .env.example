# Copy to .env (git-ignored) and fill in.

# WordPress headless CMS — WPGraphQL endpoint (include the /graphql path).
WORDPRESS_GRAPHQL_ENDPOINT=https://cms.c83group.vn/graphql

# Optional. Bearer token for private/preview queries (e.g. WPGraphQL JWT auth
# or an application password). Leave empty for public, read-only content.
WORDPRESS_AUTH_TOKEN=
